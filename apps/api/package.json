{
  "name": "@expense/api",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "nest build",
    "start": "node --env-file=../../.env dist/main",
    "start:dev": "nest start --watch --exec \"node --env-file=../../.env\"",
    "prisma:generate": "node --env-file=../../.env ../../node_modules/prisma/build/index.js generate",
    "prisma:migrate": "node --env-file=../../.env ../../node_modules/prisma/build/index.js migrate dev"
  },
  "dependencies": {
    "@expense/shared": "*",
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/cqrs": "^11.0.3",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/platform-express": "^11.0.0",
    "@prisma/client": "^6.0.0",
    "bcryptjs": "^3.0.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@types/node": "^22.0.0",
    "prisma": "^6.0.0"
  }
}
